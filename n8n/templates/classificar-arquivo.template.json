    "openrouter": { "main": [[{ "node": "validar-classificacao", "type": "main", "index": 0 }], [{ "node": "responder 500", "type": "main", "index": 0 }]] },
    "validar-classificacao": { "main": [[{ "node": "responder 200", "type": "main", "index": 0 }], [{ "node": "responder 500", "type": "main", "index": 0 }]] }
