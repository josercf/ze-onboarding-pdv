      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REVISAR-CREDENCIAL",
          "name": "Token onboarding PDV"
        }
      }
    },
    {
      "id": "config-parecer",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -260,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "config-parecer-assignment",
              "name": "modelo_parecer",
