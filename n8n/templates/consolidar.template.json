          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "montar-prompt-parecer",
      "name": "montar-prompt-parecer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "__NO__montar-prompt-parecer__"
      }
    },
    {
      "id": "entrada-ok-parecer",
      "name": "entrada ok",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "entrada-ok-parecer-condition",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "responder-400-parecer",
      "name": "responder 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        460,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ erro: $json.erro }) }}",
        "options": {
          "responseCode": "={{ $json.status }}"
        }
      }
    },
    {
      "id": "openrouter-parecer",
      "name": "openrouter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        -200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REVISAR-CREDENCIAL",
          "name": "OpenRouter"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "validar-parecer",
      "name": "validar-parecer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        -200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "__NO__validar-parecer__"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "responder-200-parecer",
      "name": "responder 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        940,
        -260
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    },
    {
      "id": "responder-502-parecer",
      "name": "responder 500",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        940,
        -80
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ erro: { codigo: 'analise_falhou', mensagem: ($json.error && $json.error.message) || $json.message || 'Falha na análise' } }) }}",
        "options": {
          "responseCode": 500
        }
      }
    }
  ],
  "connections": {
